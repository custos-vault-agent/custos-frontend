# Privy app (create one at dashboard.privy.io) — required for wallet login.
# Blocker: the frontend wiring plan cannot be tested end-to-end without this.
VITE_PRIVY_APP_ID=

# Monad RPC. The deployed contracts live here, not on local Anvil. Matches
# custos-contract's RPC_URL in its own .env.
VITE_RPC_URL=https://rpc.swiftnodes.io/rpc/monad

# 10143 = Monad testnet, 143 = Monad mainnet. Defaults to 10143.
VITE_CHAIN_ID=10143

# Deployed addresses, from custos-contract/deployments/<network>.json
# (.custosProxy and .usdc) and nansigil-contract/deployments/<network>.json
# (.nansigil). VITE_NANSIGIL may stay empty: the Nansen badge is then disabled.
# Vite inlines these at build time, so a change needs a rebuild.
VITE_CUSTOS_CORE=0xCfBbd07b107A6cb7e685e555E4C9ef956d11a0bB
VITE_USDC=0xdA4Ce9769cb5A1EF725d7847f0B8b2b7a1908645
VITE_NANSIGIL=

# Envio GraphQL endpoint for activity feed / share-price history / stats
# queries (see design spec section C). Fill in once your local Envio
# instance is running.
VITE_ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql

# Aurora Intents Connect (cross-chain deposits). Mainnet only; keep off until the
# contracts are on Monad mainnet. Server-side key from studio.aurora.dev — read by
# the /api/aurora proxy route, never bundled into the client.
VITE_AURORA_ENABLED=false
AURORA_API_KEY=
